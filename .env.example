# QuantForge Environment Configuration
# Copy to .env and fill in values

# App
APP_NAME=QuantForge
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
POSTGRES_USER=quantforge
POSTGRES_PASSWORD=quantforge_secret
POSTGRES_DB=quantforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quantforge:quantforge_secret@localhost:5432/quantforge

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@quantforge.io

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Brokers (optional - per user stored in DB)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ANGEL_ONE_API_KEY=
ANGEL_ONE_API_SECRET=

# Encryption (optional — defaults to SECRET_KEY)
ENCRYPTION_KEY=

# CSRF
CSRF_ENABLED=true

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# AI (optional)
OPENAI_API_KEY=

# NGINX
NGINX_HOST=localhost
